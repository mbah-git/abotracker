<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Meine Abos</h1>
    <p class="muted">
      <% if (filters.active) { %><%= subs.length %> von <%= total %> Abos<% } else { %><%= total %> Abo<%= total === 1 ? '' : 's' %> insgesamt<% } %>
    </p>
  </div>
  <div class="page-actions">
    <% if (subs.length) { %>
      <a class="btn" href="<%= base %>/subscriptions/export.csv<%= filters.queryString ? '?' + filters.queryString : '' %>" download
         title="<%= filters.active ? 'Exportiert nur die gefilterten Abos' : 'Exportiert alle Abos' %>">CSV exportieren</a>
    <% } %>
    <a class="btn btn-primary" href="<%= base %>/subscriptions/new">+ Neues Abo</a>
  </div>
</div>

<% if (!total) { %>
  <section class="card center empty">
    <h2>Noch keine Abos</h2>
    <p class="muted">Lege dein erstes Abo an – z. B. Netflix, Spotify oder das Fitnessstudio.</p>
    <a class="btn btn-primary" href="<%= base %>/subscriptions/new">Abo hinzufügen</a>
  </section>
<% } else { %>
<form method="get" action="<%= base %>/subscriptions" class="card filter-bar" role="search">
  <label class="filter-search">
    <span class="sr-only">Suche</span>
    <input type="search" name="q" value="<%= filters.q %>" placeholder="Suchen …" title="Sucht in Name und Notizen" maxlength="100">
  </label>
  <label>
    <span class="sr-only">Kategorie</span>
    <select name="cat" data-autosubmit>
      <option value="">Alle Kategorien</option>
      <% categories.forEach(function (c) { %>
        <option value="<%= c.id %>" <%= filters.cat === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
      <% }) %>
      <option value="none" <%= filters.cat === 'none' ? 'selected' : '' %>>Ohne Kategorie</option>
    </select>
  </label>
  <label>
    <span class="sr-only">Status</span>
    <select name="status" data-autosubmit>
      <option value="">Aktive und inaktive</option>
      <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Nur aktive</option>
      <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Nur inaktive</option>
    </select>
  </label>
  <label>
    <span class="sr-only">Sortierung</span>
    <select name="sort" data-autosubmit>
      <% Object.keys(sorts).forEach(function (key) { %>
        <option value="<%= key %>" <%= filters.sort === key ? 'selected' : '' %>>Sortieren: <%= sorts[key] %></option>
      <% }) %>
    </select>
  </label>
  <div class="filter-actions">
    <button type="submit" class="btn">Suchen</button>
    <% if (filters.active || filters.sort) { %><a class="btn btn-ghost" href="<%= base %>/subscriptions">Zurücksetzen</a><% } %>
  </div>
</form>

<% if (!subs.length) { %>
  <section class="card center empty">
    <h2>Keine Treffer</h2>
    <p class="muted">Kein Abo passt zu deiner Suche bzw. den Filtern.</p>
    <a class="btn" href="<%= base %>/subscriptions">Filter zurücksetzen</a>
  </section>
<% } else { %>
<section class="card table-card">
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Kategorie</th>
        <th class="num">Betrag</th>
        <th>Zyklus</th>
        <th class="num">pro Monat</th>
        <th>Nächste Zahlung</th>
        <th>Kündigen bis</th>
        <th><span class="sr-only">Aktionen</span></th>
      </tr>
    </thead>
    <tbody>
      <% subs.forEach(function (s) { %>
        <tr class="<%= s.is_active ? '' : 'inactive' %>">
          <td data-label="Name">
            <strong><%= s.name %></strong>
            <% if (!s.is_active) { %><span class="badge">inaktiv</span><% } %>
            <% if (s.notes) { %><div class="muted small"><%= s.notes %></div><% } %>
          </td>
          <td data-label="Kategorie">
            <% if (s.category_name) { %>
              <span class="chip"><span class="swatch" data-color="<%= s.category_color %>"></span><%= s.category_name %></span>
            <% } else { %><span class="muted">–</span><% } %>
          </td>
          <td data-label="Betrag" class="num"><div>
            <%= fmt.money(s.amount) %>
            <% if (s.share > 1) { %><div class="muted small" title="Geteilt mit <%= s.share %> Personen">÷ <%= s.share %> = <%= fmt.money(s.myAmount) %></div><% } %>
          </div></td>
          <td data-label="Zyklus"><%= s.cycleLabel %></td>
          <td data-label="pro Monat" class="num"><%= fmt.money(s.monthly) %></td>
          <td data-label="Nächste Zahlung"><%= s.is_active ? fmt.date(s.nextPayment) : '–' %></td>
          <td data-label="Kündigen bis">
            <% if (s.is_active && s.cancelBy) { %>
              <span class="<%= s.daysUntilCancel <= 7 ? 'text-warn' : '' %>"><%= fmt.date(s.cancelBy) %></span>
            <% } else { %><span class="muted">–</span><% } %>
          </td>
          <td class="actions-cell"><div class="actions">
            <a class="btn btn-sm" href="<%= base %>/subscriptions/<%= s.id %>/edit">Bearbeiten</a>
            <form method="post" action="<%= base %>/subscriptions/<%= s.id %>/delete" data-confirm="„<%= s.name %>“ wirklich löschen?">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-sm btn-danger">Löschen</button>
            </form>
          </div></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>
<% } %>
<% } %>
<%- include('../partials/footer') %>
