<%- include('../partials/header') %>
<section class="card form-card">
  <h1><%= sub ? 'Abo bearbeiten' : 'Neues Abo' %></h1>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="post" action="<%= base %>/subscriptions<%= sub ? '/' + sub.id : '' %>" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <label>Name
      <input type="text" name="name" value="<%= values.name || '' %>" required maxlength="120" placeholder="z. B. Netflix" autofocus>
    </label>

    <div class="form-row">
      <label>Betrag (CHF)
        <input type="text" name="amount" value="<%= values.amount != null ? values.amount : '' %>" required inputmode="decimal" pattern="\d+([.,]\d{1,2})?" placeholder="9.90">
      </label>
      <label>Abrechnungszyklus
        <select name="billing_cycle" required>
          <% Object.keys(cycles).forEach(function (key) { %>
            <option value="<%= key %>" <%= values.billing_cycle === key ? 'selected' : '' %>><%= cycles[key].label %></option>
          <% }) %>
        </select>
      </label>
    </div>

    <div class="form-row">
      <label>Kategorie
        <select name="category_id">
          <option value="">– keine –</option>
          <% categories.forEach(function (c) { %>
            <option value="<%= c.id %>" <%= Number(values.category_id) === c.id ? 'selected' : '' %>><%= c.name %></option>
          <% }) %>
        </select>
      </label>
      <label>Nächste Zahlung <span class="hint" data-once-hint <%= values.billing_cycle === 'once' ? '' : 'hidden' %>>bei „Einmalig“ optional</span>
        <input type="date" name="next_payment_date" value="<%= values.next_payment_date || '' %>" <%= values.billing_cycle === 'once' ? '' : 'required' %>>
      </label>
    </div>

    <label>Geteilt mit <span class="hint">Anzahl Personen inkl. dir, z. B. 4 bei Spotify Family mit 3 anderen; 1 = nicht geteilt</span>
      <input type="number" name="shared_with" value="<%= values.shared_with ?? 1 %>" min="1" max="20" step="1" required>
    </label>

    <label>Kündigen bis <span class="hint">optional · spätestes Datum, an dem du kündigen musst</span>
      <input type="date" name="cancel_by_date" value="<%= values.cancel_by_date || '' %>">
    </label>

    <label>Notizen <span class="hint">optional</span>
      <textarea name="notes" rows="3" maxlength="500"><%= values.notes || '' %></textarea>
    </label>

    <label class="checkbox">
      <input type="checkbox" name="is_active" value="1" <%= Number(values.is_active) ? 'checked' : '' %>>
      Abo ist aktiv (fließt in die Ausgaben ein)
    </label>

    <div class="form-actions">
      <a class="btn btn-ghost" href="<%= base %>/subscriptions">Abbrechen</a>
      <button type="submit" class="btn btn-primary"><%= sub ? 'Speichern' : 'Hinzufügen' %></button>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>
