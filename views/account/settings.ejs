<%- include('../partials/header') %>
<section class="card narrow">
  <h1>Einstellungen</h1>
  <p class="muted">Angemeldet als <%= currentUser.email %></p>

  <form method="post" action="<%= base %>/account" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2 class="section-title">E-Mail-Erinnerungen</h2>
    <label class="checkbox">
      <input type="checkbox" name="reminders_enabled" value="1" <%= currentUser.reminders_enabled ? 'checked' : '' %>>
      Vor Kündigungsfristen erinnern
    </label>
    <label class="checkbox">
      <input type="checkbox" name="payment_reminders_enabled" value="1" <%= currentUser.payment_reminders_enabled ? 'checked' : '' %>>
      Vor der nächsten Zahlung erinnern
    </label>
    <p class="muted small">Erinnerungen kommen 14 Tage, 7 Tage und 1 Tag vorher an <%= currentUser.email %>,
      gesammelt in höchstens einer E-Mail pro Tag. Das gilt für aktive Abos mit eingetragenem Datum.
      Bei wöchentlichen Abos gibt es vor Zahlungen nur die Erinnerung 1 Tag vorher.</p>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Speichern</button>
    </div>
  </form>

  <hr class="divider">
  <h2 class="section-title">Passwort</h2>
  <a class="btn" href="<%= base %>/account/password">Passwort ändern</a>
</section>
<%- include('../partials/footer') %>
