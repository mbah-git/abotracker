<%- include('../partials/header') %>
<section class="card narrow">
  <h1>Passwort ändern</h1>
  <p class="muted">Angemeldet als <%= currentUser.email %></p>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="post" action="<%= base %>/account/password" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="text" name="username" value="<%= currentUser.email %>" autocomplete="username" hidden>
    <label>Aktuelles Passwort
      <input type="password" name="current_password" required autocomplete="current-password" autofocus>
    </label>
    <label>Neues Passwort <span class="hint">mind. 8 Zeichen</span>
      <input type="password" name="password" required minlength="8" autocomplete="new-password">
    </label>
    <label>Neues Passwort wiederholen
      <input type="password" name="password_confirm" required minlength="8" autocomplete="new-password">
    </label>
    <div class="form-actions">
      <a class="btn btn-ghost" href="<%= base %>/dashboard">Abbrechen</a>
      <button type="submit" class="btn btn-primary">Passwort ändern</button>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>
