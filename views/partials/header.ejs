<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · AboTracker</title>
  <link rel="icon" href="<%= base %>/static/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="<%= base %>/static/css/style.css">
  <link rel="manifest" href="<%= base %>/manifest.webmanifest">
  <link rel="apple-touch-icon" href="<%= base %>/static/icons/apple-touch-icon.png">
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1b1e27" media="(prefers-color-scheme: dark)">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="AboTracker">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
</head>
<body data-base="<%= base %>">
  <header class="topbar">
    <div class="container topbar-inner">
      <a class="brand" href="<%= base %>/">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5Zm4 3v2h8V8H8Zm0 4v2h8v-2H8Zm0 4v2h5v-2H8Z"/></svg>
        AboTracker
      </a>
      <% if (currentUser) { %>
        <nav class="nav">
          <a href="<%= base %>/dashboard" class="<%= path === '/dashboard' ? 'active' : '' %>">Übersicht</a>
          <a href="<%= base %>/subscriptions" class="<%= path.startsWith('/subscriptions') ? 'active' : '' %>">Meine Abos</a>
          <% if (currentUser.role === 'admin') { %>
            <a href="<%= base %>/admin/users" class="<%= path.startsWith('/admin') ? 'active' : '' %>">Benutzer</a>
          <% } %>
        </nav>
        <div class="user-menu">
          <button type="button" id="installBtn" class="btn btn-sm" hidden>App installieren</button>
          <a class="user-name <%= path.startsWith('/account') ? 'active' : '' %>" href="<%= base %>/account" title="<%= currentUser.email %> · Einstellungen"><%= currentUser.name %></a>
          <form method="post" action="<%= base %>/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-ghost btn-sm">Abmelden</button>
          </form>
        </div>
      <% } else { %>
        <div class="user-menu">
          <button type="button" id="installBtn" class="btn btn-sm" hidden>App installieren</button>
        </div>
      <% } %>
    </div>
  </header>
  <main class="container main">
    <% if (flash) { %>
      <div class="alert alert-<%= flash.type %>" role="status"><%= flash.message %></div>
    <% } %>
