<%- include('../partials/header') %>
<section class="card narrow">
  <h1>Neuen Benutzer erstellen</h1>
  <p class="muted">Der Benutzer kann sich danach mit E-Mail und Passwort anmelden.</p>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="post" action="<%= base %>/admin/users/new" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Name
      <input type="text" name="name" value="<%= values.name || '' %>" required maxlength="100" placeholder="z. B. Max Mustermann" autofocus>
    </label>
    <label>E-Mail
      <input type="email" name="email" value="<%= values.email || '' %>" required maxlength="190" autocomplete="off" placeholder="z. B. max@example.com">
    </label>
    <label>Passwort <span class="hint">mind. 8 Zeichen</span>
      <input type="password" name="password" required minlength="8" autocomplete="new-password">
    </label>
    <label>Passwort wiederholen
      <input type="password" name="password_confirm" required minlength="8" autocomplete="new-password">
    </label>
    <label>Rolle
      <select name="role">
        <option value="user" <%= values.role !== 'admin' ? 'selected' : '' %>>Benutzer</option>
        <option value="admin" <%= values.role === 'admin' ? 'selected' : '' %>>Administrator</option>
      </select>
    </label>
    <label class="checkbox">
      <input type="checkbox" name="demo" value="1" <%= values.demo ? 'checked' : '' %>>
      Beispiel-Abos anlegen (Amazon Prime, YouTube Premium, Urban Sports Club)
    </label>
    <div class="form-actions">
      <a class="btn btn-ghost" href="<%= base %>/admin/users">Abbrechen</a>
      <button type="submit" class="btn btn-primary">Benutzer erstellen</button>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>
