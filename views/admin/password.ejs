<%- include('../partials/header') %>
<section class="card narrow">
  <h1>Passwort zurücksetzen</h1>
  <p class="muted">Neues Passwort für <strong><%= user.name %></strong> (<%= user.email %>).</p>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="post" action="<%= base %>/admin/users/<%= user.id %>/password" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Neues Passwort <span class="hint">mind. 8 Zeichen</span>
      <input type="password" name="password" required minlength="8" autocomplete="new-password" autofocus>
    </label>
    <label>Passwort wiederholen
      <input type="password" name="password_confirm" required minlength="8" autocomplete="new-password">
    </label>
    <div class="form-actions">
      <a class="btn btn-ghost" href="<%= base %>/admin/users">Abbrechen</a>
      <button type="submit" class="btn btn-primary">Passwort setzen</button>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>
