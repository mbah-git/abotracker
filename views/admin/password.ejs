<%- include('../partials/header') %>
<section class="card narrow">
  <h1>Passwort ändern</h1>
  <p class="muted">Setze ein neues Passwort für einen beliebigen Benutzer.</p>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <form method="post" action="<%= base %>/admin/password" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Benutzer
      <select name="user_id" required <%= selectedId ? '' : 'autofocus' %>>
        <option value="">– Benutzer wählen –</option>
        <% users.forEach(function (u) { %>
          <option value="<%= u.id %>" <%= u.id === selectedId ? 'selected' : '' %>><%= u.name %> (<%= u.email %>)<%= u.id === currentUser.id ? ' – du' : '' %></option>
        <% }) %>
      </select>
    </label>
    <label>Neues Passwort <span class="hint">mind. 8 Zeichen</span>
      <input type="password" name="password" required minlength="8" autocomplete="new-password" <%= selectedId ? 'autofocus' : '' %>>
    </label>
    <label>Passwort wiederholen
      <input type="password" name="password_confirm" required minlength="8" autocomplete="new-password">
    </label>
    <div class="form-actions">
      <a class="btn btn-ghost" href="<%= base %>/admin/users">Abbrechen</a>
      <button type="submit" class="btn btn-primary">Passwort setzen</button>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>
