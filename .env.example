# Kopiere diese Datei nach .env (lokal) ODER trage die Werte in cPanel unter
# "Setup Node.js App" -> Environment variables ein. Die .env wird NIE eingecheckt.

NODE_ENV=production

# MySQL-Datenbank (bei Namecheap: Host localhost)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=abotrackerdb
DB_USER=abotrackeruser
DB_PASSWORD=

# Langer Zufallswert, z. B.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Admin-User fuer "npm run seed"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Optional
# BASE_PATH=/abotracker      # nur, wenn die App in einem Unterordner laeuft
# ALLOW_REGISTRATION=false   # oeffentliche Registrierung abschalten
# SEED_DEMO_USER=false       # keinen Demo-Benutzer anlegen
